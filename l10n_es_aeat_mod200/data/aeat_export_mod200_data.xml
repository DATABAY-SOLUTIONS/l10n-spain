     Main export config for Modelo 200 (envelope). -->
<odoo>
    <record id="aeat_mod200_export_config" model="aeat.model.export.config">
        <field name="name">Mod. 200 2025-actualidad</field>
        <field name="model_number">200</field>
        <field
            name="model_id"
            ref="l10n_es_aeat_mod200.model_l10n_es_aeat_mod200_report"
        />
        <field name="date_start">2025-01-01</field>
        <field name="active" eval="True" />
    </record>

    <!-- Envelope opening -->
    <record id="aeat_mod200_export_line_01" model="aeat.model.export.config.line">
        <field name="sequence">1</field>
        <field name="export_config_id" ref="aeat_mod200_export_config" />
        <field name="name">Apertura envelope</field>
        <field name="expression">&lt;T2000${object.year}0A0000&gt;</field>
        <field name="export_type">string</field>
        <field name="size">18</field>
        <field name="alignment">left</field>
    </record>

    <!-- AUX block -->
    <record id="aeat_mod200_export_line_02" model="aeat.model.export.config.line">
        <field name="sequence">2</field>
        <field name="export_config_id" ref="aeat_mod200_export_config" />
        <field name="name">AUX apertura</field>
        <field name="fixed_value">&lt;AUX&gt;</field>
        <field name="export_type">string</field>
        <field name="size">5</field>
        <field name="alignment">left</field>
    </record>
    <record id="aeat_mod200_export_line_03" model="aeat.model.export.config.line">
        <field name="sequence">3</field>
        <field name="export_config_id" ref="aeat_mod200_export_config" />
        <field name="name">Reservado Administración</field>
        <field name="fixed_value" />
        <field name="export_type">string</field>
        <field name="size">70</field>
        <field name="alignment">left</field>
    </record>
    <record id="aeat_mod200_export_line_04" model="aeat.model.export.config.line">
        <field name="sequence">4</field>
        <field name="export_config_id" ref="aeat_mod200_export_config" />
        <field name="name">Versión Programa</field>
        <field name="fixed_value">odoo</field>
        <field name="export_type">string</field>
        <field name="size">4</field>
        <field name="alignment">left</field>
    </record>
    <record id="aeat_mod200_export_line_05" model="aeat.model.export.config.line">
        <field name="sequence">5</field>
        <field name="export_config_id" ref="aeat_mod200_export_config" />
        <field name="name">Reservado</field>
        <field name="fixed_value" />
        <field name="export_type">string</field>
        <field name="size">4</field>
        <field name="alignment">left</field>
    </record>
    <record id="aeat_mod200_export_line_06" model="aeat.model.export.config.line">
        <field name="sequence">6</field>
        <field name="export_config_id" ref="aeat_mod200_export_config" />
        <field name="name">NIF Empresa Desarrollo</field>
        <field name="fixed_value">B44682654</field>
        <field name="export_type">string</field>
        <field name="size">9</field>
        <field name="alignment">left</field>
    </record>
    <record id="aeat_mod200_export_line_07" model="aeat.model.export.config.line">
        <field name="sequence">7</field>
        <field name="export_config_id" ref="aeat_mod200_export_config" />
        <field name="name">Reservado Administración</field>
        <field name="fixed_value" />
        <field name="export_type">string</field>
        <field name="size">213</field>
        <field name="alignment">left</field>
    </record>
    <record id="aeat_mod200_export_line_08" model="aeat.model.export.config.line">
        <field name="sequence">8</field>
        <field name="export_config_id" ref="aeat_mod200_export_config" />
        <field name="name">AUX cierre</field>
        <field name="fixed_value">&lt;/AUX&gt;</field>
        <field name="export_type">string</field>
        <field name="size">6</field>
        <field name="alignment">left</field>
    </record>

    <!-- Subconfig pages -->
    <record id="aeat_mod200_export_line_09" model="aeat.model.export.config.line">
        <field name="sequence">9</field>
        <field name="export_config_id" ref="aeat_mod200_export_config" />
        <field name="name">Página 01 - Identificación</field>
        <field name="conditional_expression">True</field>
        <field name="subconfig_id" ref="aeat_mod200_sub01_export_config" />
        <field name="export_type">subconfig</field>
    </record>
    <record id="aeat_mod200_export_line_10" model="aeat.model.export.config.line">
        <field name="sequence">10</field>
        <field name="export_config_id" ref="aeat_mod200_export_config" />
        <field name="name">Páginas 03-06 - Balance</field>
        <field name="conditional_expression">True</field>
        <field name="subconfig_id" ref="aeat_mod200_sub03_export_config" />
        <field name="export_type">subconfig</field>
    </record>
    <record id="aeat_mod200_export_line_11" model="aeat.model.export.config.line">
        <field name="sequence">11</field>
        <field name="export_config_id" ref="aeat_mod200_export_config" />
        <field name="name">Páginas 07-08 - PyG</field>
        <field name="conditional_expression">True</field>
        <field name="subconfig_id" ref="aeat_mod200_sub07_export_config" />
        <field name="export_type">subconfig</field>
    </record>
    <record id="aeat_mod200_export_line_12" model="aeat.model.export.config.line">
        <field name="sequence">12</field>
        <field name="export_config_id" ref="aeat_mod200_export_config" />
        <field name="name">Páginas 12-14 - Liquidación</field>
        <field name="conditional_expression">True</field>
        <field name="subconfig_id" ref="aeat_mod200_sub12_export_config" />
        <field name="export_type">subconfig</field>
    </record>

    <!-- Envelope closing -->
    <record id="aeat_mod200_export_line_13" model="aeat.model.export.config.line">
        <field name="sequence">13</field>
        <field name="export_config_id" ref="aeat_mod200_export_config" />
        <field name="name">Cierre envelope</field>
        <field name="expression">&lt;/T2000${object.year}0A0000&gt;</field>
        <field name="export_type">string</field>
        <field name="size">19</field>
        <field name="alignment">left</field>
    </record>
</odoo>
