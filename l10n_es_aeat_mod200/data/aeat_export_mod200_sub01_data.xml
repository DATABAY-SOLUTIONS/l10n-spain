<odoo>
    <record id="aeat_mod200_sub01_export_config" model="aeat.model.export.config">
        <field name="name">Mod. 200 - Página 01 (Identificación)</field>
        <field name="model_number">200</field>
        <field name="active" eval="False" />
    </record>
    <record id="aeat_mod200_s01_line_01" model="aeat.model.export.config.line">
        <field name="sequence">1</field>
        <field name="export_config_id" ref="aeat_mod200_sub01_export_config" />
        <field name="name">Inicio page tag</field>
        <field name="fixed_value">&lt;T</field>
        <field name="export_type">string</field>
        <field name="size">2</field>
        <field name="alignment">left</field>
    </record>
    <record id="aeat_mod200_s01_line_02" model="aeat.model.export.config.line">
        <field name="sequence">2</field>
        <field name="export_config_id" ref="aeat_mod200_sub01_export_config" />
        <field name="name">Modelo</field>
        <field name="fixed_value">200</field>
        <field name="export_type">string</field>
        <field name="size">3</field>
        <field name="alignment">left</field>
    </record>
    <record id="aeat_mod200_s01_line_03" model="aeat.model.export.config.line">
        <field name="sequence">3</field>
        <field name="export_config_id" ref="aeat_mod200_sub01_export_config" />
        <field name="name">Página</field>
        <field name="fixed_value">01</field>
        <field name="export_type">string</field>
        <field name="size">2</field>
        <field name="alignment">left</field>
    </record>
    <record id="aeat_mod200_s01_line_04" model="aeat.model.export.config.line">
        <field name="sequence">4</field>
        <field name="export_config_id" ref="aeat_mod200_sub01_export_config" />
        <field name="name">Fin tag</field>
        <field name="fixed_value">000&gt;</field>
        <field name="export_type">string</field>
        <field name="size">4</field>
        <field name="alignment">left</field>
    </record>
    <record id="aeat_mod200_s01_line_05" model="aeat.model.export.config.line">
        <field name="sequence">5</field>
        <field name="export_config_id" ref="aeat_mod200_sub01_export_config" />
        <field name="name">Tipo declaración</field>
        <field name="expression">${object.tipo_declaracion or 'N'}</field>
        <field name="export_type">string</field>
        <field name="size">1</field>
        <field name="alignment">left</field>
    </record>
    <record id="aeat_mod200_s01_line_06" model="aeat.model.export.config.line">
        <field name="sequence">6</field>
        <field name="export_config_id" ref="aeat_mod200_sub01_export_config" />
        <field name="name">NIF</field>
        <field name="expression">${object.company_vat or ''}</field>
        <field name="export_type">string</field>
        <field name="size">9</field>
        <field name="alignment">left</field>
    </record>
    <record id="aeat_mod200_s01_line_07" model="aeat.model.export.config.line">
        <field name="sequence">7</field>
        <field name="export_config_id" ref="aeat_mod200_sub01_export_config" />
        <field name="name">Razón social</field>
        <field name="expression">${object.company_id.name or ''}</field>
        <field name="export_type">string</field>
        <field name="size">80</field>
        <field name="alignment">left</field>
    </record>
    <record id="aeat_mod200_s01_line_08" model="aeat.model.export.config.line">
        <field name="sequence">8</field>
        <field name="export_config_id" ref="aeat_mod200_sub01_export_config" />
        <field name="name">Tipo cuentas anuales</field>
        <field name="expression">${object.tipo_cuentas_anuales or 'P'}</field>
        <field name="export_type">string</field>
        <field name="size">1</field>
        <field name="alignment">left</field>
    </record>
    <record id="aeat_mod200_s01_line_09" model="aeat.model.export.config.line">
        <field name="sequence">9</field>
        <field name="export_config_id" ref="aeat_mod200_sub01_export_config" />
        <field name="name">CNAE actividad</field>
        <field name="expression">${object.cnae_actividad or ''}</field>
        <field name="export_type">string</field>
        <field name="size">4</field>
        <field name="alignment">left</field>
    </record>
    <record id="aeat_mod200_s01_line_10" model="aeat.model.export.config.line">
        <field name="sequence">10</field>
        <field name="export_config_id" ref="aeat_mod200_sub01_export_config" />
        <field name="name">Régimen general</field>
        <field name="expression">${'X' if object.regimen_general else ' '}</field>
        <field name="export_type">string</field>
        <field name="size">1</field>
        <field name="alignment">left</field>
    </record>
    <record id="aeat_mod200_s01_line_11" model="aeat.model.export.config.line">
        <field name="sequence">11</field>
        <field name="export_config_id" ref="aeat_mod200_sub01_export_config" />
        <field name="name">ERD</field>
        <field name="expression">${'X' if object.regimen_erd else ' '}</field>
        <field name="export_type">string</field>
        <field name="size">1</field>
        <field name="alignment">left</field>
    </record>
    <record id="aeat_mod200_s01_line_12" model="aeat.model.export.config.line">
        <field name="sequence">12</field>
        <field name="export_config_id" ref="aeat_mod200_sub01_export_config" />
        <field name="name">Gran empresa</field>
        <field name="expression">${'X' if object.gran_empresa else ' '}</field>
        <field name="export_type">string</field>
        <field name="size">1</field>
        <field name="alignment">left</field>
    </record>
    <record id="aeat_mod200_s01_line_13" model="aeat.model.export.config.line">
        <field name="sequence">13</field>
        <field name="export_config_id" ref="aeat_mod200_sub01_export_config" />
        <field name="name">Tipo gravamen</field>
        <field name="expression">${object.tipo_gravamen or '25'}</field>
        <field name="export_type">string</field>
        <field name="size">4</field>
        <field name="alignment">right</field>
    </record>
    <record id="aeat_mod200_s01_line_14" model="aeat.model.export.config.line">
        <field name="sequence">14</field>
        <field name="export_config_id" ref="aeat_mod200_sub01_export_config" />
        <field name="name">Reservado pagina 01</field>
        <field name="fixed_value" />
        <field name="export_type">string</field>
        <field name="size">500</field>
        <field name="alignment">left</field>
    </record>
    <record id="aeat_mod200_s01_line_15" model="aeat.model.export.config.line">
        <field name="sequence">15</field>
        <field name="export_config_id" ref="aeat_mod200_sub01_export_config" />
        <field name="name">Cierre página 01</field>
        <field name="fixed_value">&lt;/T20001000&gt;</field>
        <field name="export_type">string</field>
        <field name="size">14</field>
        <field name="alignment">left</field>
    </record>
</odoo>
